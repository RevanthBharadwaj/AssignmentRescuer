{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assignment Rescue AI",
  "version": "0.1.0",
  "identifier": "ai.assignmentrescue.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Assignment Rescue AI", "width": 1200, "height": 820, "minWidth": 900, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Education",
    "shortDescription": "Academic planning, research and writing assistant"
  }
}
